-- CLOSEST LIMB HELPER — returns the single bodypart nearest to a point
-- ═══════════════════════════════════════════════════════════════════
local VALID_LIMB_NAMES = {
    ["Head"] = true, ["Torso"] = true,
    ["Right Arm"] = true, ["Left Arm"] = true,
    ["Right Leg"] = true, ["Left Leg"] = true,
    ["Right Foot"] = true, ["Left Foot"] = true,
    ["RightUpperLeg"] = true, ["LeftUpperLeg"] = true,
    ["RightLowerLeg"] = true, ["LeftLowerLeg"] = true,
    ["RightUpperArm"] = true, ["LeftUpperArm"] = true,
    ["RightLowerArm"] = true, ["LeftLowerArm"] = true,
    ["RightHand"] = true, ["LeftHand"] = true,
    ["RightShoulder"] = true, ["LeftShoulder"] = true,
    ["UpperTorso"] = true, ["LowerTorso"] = true,
    ["H"] = true, ["T"] = true,
    ["RA"] = true, ["LA"] = true,
    ["RL"] = true, ["LL"] = true,
}

local function findClosestLimbToBall(char: Model, ballPos: Vector3): BasePart?
    local closest, minDist = nil, math.huge
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") and VALID_LIMB_NAMES[part.Name] then
            local dx = part.Position.X - ballPos.X
            local dy = part.Position.Y - ballPos.Y
            local dz = part.Position.Z - ballPos.Z
            local d = dx*dx + dy*dy + dz*dz
            if d < minDist then
                minDist = d
                closest = part
            end
        end
    end
    return closest
end

---------------------------------------------------------------------
-- MAIN REACH — fires on all limbs
---------------------------------------------------------------------
local function processReachFrame(char: Model)
    if not Config.Enabled then
        if visualizerBox then visualizerBox.Visible = false end
        return
    end

    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if not root then return end

    local zOffset = -Config.ForwardOffset + Config.BehindOffset
    local targetCF = root.CFrame * CFrame.new(0, 0, zOffset)
    
    if proxyAnchor and proxyAnchor.Parent then
        proxyAnchor.CFrame = targetCF
    else
        setupVisualizer()
        return
    end

    if visualizerBox then
        visualizerBox.Visible = Config.Enabled and Config.Visualizer
        visualizerBox.Size = Config.ReachSize
        visualizerBox.Color3 = Config.VisualizerColor
    end

    local balls = getActiveBalls()
    if #balls == 0 then return end

    local limbs = {}
    for _, limbName in ipairs({"Right Leg", "Left Leg", "Right Foot", "Left Foot", "RL", "LL", "Torso", "HumanoidRootPart", "RA", "LA", "H", "T"}) do
        local limb = char:FindFirstChild(limbName)
        if limb and limb:IsA("BasePart") then
            table.insert(limbs, limb)
        end
    end

    if #limbs == 0 then return end

    local now = tick()
    for _, ball in ipairs(balls) do
        if isPointInOBB(targetCF, Config.ReachSize, ball.Position) then
            if not lastTouchTime[ball] or (now - lastTouchTime[ball]) > 0.03 then
                lastTouchTime[ball] = now
                for _, limb in ipairs(limbs) do
                    if fireTouch then
                        fireTouch(limb, ball, 0)
                        fireTouch(ball, limb, 0)
                        task.defer(function()
                            if limb.Parent and ball.Parent then
                                fireTouch(limb, ball, 1)
                                fireTouch(ball, limb, 1)
                            end
                        end)
                    end
                end
            end
        end
    end
end

---------------------------------------------------------------------
-- GK REACH — box stays on character, fires ONLY the closest limb
---------------------------------------------------------------------
local function processGKReachFrame(char: Model)
    if not GKConfig.Enabled then
        if gkVisualizerBox then gkVisualizerBox.Visible = false end
        return
    end

    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if not root then return end

    -- Box stays anchored to the character (centered on HRP + offset)
    local zOffset = -GKConfig.ForwardOffset + GKConfig.BehindOffset
    local targetCF = root.CFrame * CFrame.new(0, 0, zOffset)

    if gkProxyAnchor and gkProxyAnchor.Parent then
        gkProxyAnchor.CFrame = targetCF
    else
        setupGKVisualizer()
        return
    end

    if gkVisualizerBox then
        gkVisualizerBox.Visible = GKConfig.Enabled and GKConfig.Visualizer
        gkVisualizerBox.Size = GKConfig.ReachSize
        gkVisualizerBox.Color3 = GKConfig.VisualizerColor
    end

    local balls = getActiveBalls()
    if #balls == 0 then return end

    local now = tick()
    for _, ball in ipairs(balls) do
        if isPointInOBB(targetCF, GKConfig.ReachSize, ball.Position) then
            if not gkLastTouchTime[ball] or (now - gkLastTouchTime[ball]) > GKConfig.TouchCooldown then
                gkLastTouchTime[ball] = now

                -- Fire ONLY on the closest bodypart to this ball
                local closestLimb = findClosestLimbToBall(char, ball.Position)
                if closestLimb and fireTouch then
                    fireTouch(closestLimb, ball, 0)
                    fireTouch(ball, closestLimb, 0)
                    task.defer(function()
                        if closestLimb.Parent and ball.Parent then
                            fireTouch(closestLimb, ball, 1)
                            fireTouch(ball, closestLimb, 1)
                        end
                    end)
                end
            end
        end
    end
end

