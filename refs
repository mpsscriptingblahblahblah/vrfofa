        landingAnchor.CanCollide = false
        landingAnchor.CanTouch = false
        landingAnchor.CanQuery = false
        landingAnchor.Massless = true
        landingAnchor.Anchored = true
        landingAnchor.Parent = Workspace.CurrentCamera

        local landAdorn = Instance.new("CylinderHandleAdornment")
        landAdorn.Name = "VEF_LandingCircle"
        landAdorn.Color3 = TrajectoryConfig.LandingColor
        landAdorn.Transparency = 1
        landAdorn.AlwaysOnTop = true
        landAdorn.ZIndex = 9
        landAdorn.Adornee = landingAnchor
        landAdorn.Radius = TrajectoryConfig.LandingSize * 0.5
        landAdorn.Height = 0.1
        landAdorn.CFrame = CFrame.Angles(math.rad(90), 0, 0)
        landAdorn.Parent = getHui()
        landingAdornment = landAdorn
    end
end

local function hideTrajectory()
    for _, adorn in ipairs(trajAdornments) do
        adorn.Transparency = 1
    end
    if landingAdornment then
        landingAdornment.Transparency = 1
    end
end

local function isLocalPlayerNear(bp: BasePart)
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if not hrp then return false end
    return (hrp.Position - bp.Position).Magnitude < 35
end

local function checkTrajectoryTrigger(b: BasePart)
    if TrajectoryConfig.AlwaysShow then return true end

    local speed = b.AssemblyLinearVelocity.Magnitude
    local now = tick()
    local jumped = (speed - prevVel) >= TrajectoryConfig.TriggerJump
    local fast = speed >= TrajectoryConfig.TriggerSpeed
    local close = isLocalPlayerNear(b)

    if close and (jumped or (fast and prevVel < TrajectoryConfig.TriggerSpeed)) then
        showUntil = now + TrajectoryConfig.ShowDuration
    end

    prevVel = speed
    return now < showUntil
end

local function simulateTrajectory(ballPart: BasePart)
    local pos = ballPart.Position
    local vel = ballPart.AssemblyLinearVelocity
    local g = Workspace.Gravity or baseGravity

    local points = { pos }
    local landingPos = nil
    if vel.Magnitude < 0.5 then return points, pos end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { ballPart }

    local bounces = 0
    local maxSteps = math.floor(TrajectoryConfig.PredictTime / TrajectoryConfig.SimDT)

    for _ = 1, maxSteps do
        local stepVel = vel + Vector3.new(0, -g * TrajectoryConfig.SimDT, 0)
        local drag = TrajectoryConfig.AirDrag * stepVel.Magnitude * TrajectoryConfig.SimDT
        stepVel = stepVel * math.max(0, 1 - drag)

        local stepPos = pos + stepVel * TrajectoryConfig.SimDT
        local rayDir = stepPos - pos

        local hit = nil
        if rayDir.Magnitude > 0 then
            hit = Workspace:Raycast(pos, rayDir, params)
        end

        if hit then
            local hitPos = hit.Position
            local normal = hit.Normal.Unit
            local vn = stepVel:Dot(normal)

            if normal.Y > 0.7 and not landingPos then
                landingPos = hitPos
            end

            if vn < 0 then
                local vNormal = normal * vn
                local vTangent = stepVel - vNormal
                stepVel = vTangent * TrajectoryConfig.GroundFriction - vNormal * TrajectoryConfig.Restitution
            end

            stepPos = hitPos + normal * 0.05
            bounces = bounces + 1
            table.insert(points, stepPos)

            if stepVel.Magnitude < 2.5 then break end
            if bounces > TrajectoryConfig.MaxBounces then break end
        else
            table.insert(points, stepPos)
        end

        pos = stepPos
        vel = stepVel
    end

    if not landingPos then landingPos = points[#points] end
    return points, landingPos
end

local function drawTrajectoryTrail(ballPart: BasePart)
    initStealthTrajectoryVisuals()

    local pts, landingPos = simulateTrajectory(ballPart)
    local step = math.max(1, math.floor(#pts / TrajectoryConfig.NumMarkers))

    for i = 1, TrajectoryConfig.NumMarkers do
        local idx = math.min(#pts, (i - 1) * step + 1)
        local anchor = trajAnchors[i]
        local adorn = trajAdornments[i]

        if anchor and adorn and pts[idx] and idx <= #pts then
            local frac = i / TrajectoryConfig.NumMarkers
            anchor.CFrame = CFrame.new(pts[idx])
            adorn.Transparency = 0.05 + 0.55 * frac
            adorn.Color3 = TrajectoryConfig.MarkerColor
            adorn.Radius = (TrajectoryConfig.MarkerSize * 0.5) * (1 - 0.4 * frac)
        elseif adorn then
            adorn.Transparency = 1
        end
    end

    if landingAnchor and landingAdornment and landingPos then
        landingAnchor.CFrame = CFrame.new(landingPos + Vector3.new(0, 0.05, 0))
        landingAdornment.Radius = TrajectoryConfig.LandingSize * 0.5
        landingAdornment.Color3 = TrajectoryConfig.LandingColor
        landingAdornment.Transparency = 0.15
    end
end

