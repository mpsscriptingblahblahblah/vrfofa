local function getTCSCharacter(player)
    player = player or LocalPlayer
    local char = player.Character
    if char and char.Parent then return char end
    local wsChars = Workspace:FindFirstChild("WorkspaceCharacters")
    if wsChars then
        local found = wsChars:FindFirstChild(player.Name)
        if found then return found end
    end
    return nil
end

local function getRoot(p): BasePart?
    local c = getTCSCharacter(p)
    return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c.PrimaryPart) :: BasePart?
end

local function getHumanoid(p): Humanoid?
    local c = getTCSCharacter(p)
    return c and c:FindFirstChildWhichIsA("Humanoid") :: Humanoid?
end

local function isPlayerMoving(): boolean
    local h = getHumanoid(LocalPlayer)
    if h and h.MoveDirection.Magnitude > 0.1 then return true end
    return UserInputService:IsKeyDown(Enum.KeyCode.W)
        or UserInputService:IsKeyDown(Enum.KeyCode.A)
        or UserInputService:IsKeyDown(Enum.KeyCode.S)
        or UserInputService:IsKeyDown(Enum.KeyCode.D)
end

local function trackBall(obj)
    if not obj or not isBallPart(obj) or trackedSet[obj] then return end
    trackedSet[obj] = true
    table.insert(trackedBalls, obj)
end

local function untrackBall(obj)
    if not obj or not trackedSet[obj] then return end
    trackedSet[obj] = nil
    for i = #trackedBalls, 1, -1 do
        if trackedBalls[i] == obj then
            table.remove(trackedBalls, i)
            break
        end
    end
end

local function rebuildBallCache()
    trackedBalls = {}
    trackedSet = {}
    local folder = getBallsFolder()
    if folder then
        for _, v in ipairs(folder:GetDescendants()) do
            if v:IsA("BasePart") then
                trackedSet[v] = true
                table.insert(trackedBalls, v)
            end
        end
    else
        for _, v in ipairs(Workspace:GetDescendants()) do
            if isBallPart(v) then
                trackedSet[v] = true
                table.insert(trackedBalls, v)
            end
        end
    end
end

local function findClosestBall(pos: Vector3): BasePart?
    local closest: BasePart?, minDist = nil, math.huge
    for i = #trackedBalls, 1, -1 do
        local v = trackedBalls[i]
        if not (v and v.Parent) then
            trackedSet[v] = nil
            table.remove(trackedBalls, i)
        else
            local dx = pos.X - v.Position.X
            local dy = pos.Y - v.Position.Y
            local dz = pos.Z - v.Position.Z
            local d = dx*dx + dy*dy + dz*dz
            if d < minDist then
                minDist = d
                closest = v
            end
        end
    end
    return closest
end

local function issueMove(humanoid: Humanoid, pos: Vector3)
    if not humanoid or not pos then return end
    local s = getgenv().settings
    local now = os.clock()
    if s.moveInterval > 0 and (now - lastMoveAt) < s.moveInterval and lastMoveTarget then
        local dx = pos.X - lastMoveTarget.X
        local dy = pos.Y - lastMoveTarget.Y
        local dz = pos.Z - lastMoveTarget.Z
        if (dx*dx + dy*dy + dz*dz) <= (s.moveEpsilon * s.moveEpsilon) then return end
    end
    lastMoveAt = now
    lastMoveTarget = pos
    humanoid:MoveTo(pos)
end

local function calculateLandingSpot(pos: Vector3, vel: Vector3, floorY: number): (Vector3, number)
    local g = Workspace.Gravity or baseGravity
    local h = pos.Y - floorY
    if h < 0.5 then
        return Vector3.new(pos.X, floorY, pos.Z), 0
    end
    local vy = vel.Y
    local disc = vy * vy + 2 * g * h
    if disc < 0 then
        return Vector3.new(pos.X, floorY, pos.Z), 0
    end
    local t = math.clamp((vy + math.sqrt(disc)) / g, 0, getgenv().settings.maxPredTime)
    local lx, lz
    if getgenv().settings.useCurves then
        lx = pos.X + vel.X * t + 0.5 * smoothAcc.X * t * t
        lz = pos.Z + vel.Z * t + 0.5 * smoothAcc.Z * t * t
    else
        lx = pos.X + vel.X * t
        lz = pos.Z + vel.Z * t
    end
    return Vector3.new(lx, floorY, lz), t
end

local function calculateGroundPrediction(bpos: Vector3, bvel: Vector3, mpos: Vector3): Vector3
    local s = getgenv().settings
    local acc2dMag = math.sqrt(smoothAcc.X * smoothAcc.X + smoothAcc.Z * smoothAcc.Z)
    local isFlick = acc2dMag > s.flickThreshold
    local pt = isFlick and (s.predPower * s.flickMult) or s.predPower
    pt = math.min(pt, s.maxPredTime)
    local pv = (isFlick and s.useCurves) and (bvel + smoothAcc * 0.15) or bvel
    local future = s.useCurves and (bpos + pv * pt + 0.5 * smoothAcc * pt * pt) or (bpos + pv * pt)
    return Vector3.new(future.X, mpos.Y, future.Z)
end

local function updateAcceleration(vel: Vector3)
    local now = os.clock()
    local dt = now - lastTime
    if dt < 0.005 then return end
    local rawAcc = (vel - lastVel) / dt
    if rawAcc.Magnitude > 500 then
        rawAcc = rawAcc.Unit * 500
    end
    local alpha = math.clamp(getgenv().settings.accelSmooth, 0.05, 0.95)
    smoothAcc = smoothAcc:Lerp(rawAcc, alpha)
    lastVel = vel
    lastTime = now
end

local scanTask = task.spawn(function()
    while true do
        if getgenv().guarding then
            local r = getRoot(LocalPlayer)
            targetBall = r and findClosestBall(r.Position) or nil
        else
            targetBall = nil
        end
        task.wait(0.35)
    end
end)

local function ProcessCharacterBypass(char: Model)
    setupCharacterPhysics(char)
    char:WaitForChild("Humanoid", 10)
    for i = 1, 15 do
        SweepCharacterConnections(char)
        task.wait(0.2)
    end
end

