local function getBallsFolder()
    if ballsFolderChecked then
        if ballsFolderRef and ballsFolderRef.Parent then
            return ballsFolderRef
        elseif ballsFolderRef then
            ballsFolderRef = nil
            ballsFolderChecked = false
        end
    end
    ballsFolderRef = Workspace:FindFirstChild("Balls")
    ballsFolderChecked = true
    return ballsFolderRef
end

local function invalidateBallsFolderCache()
    ballsFolderChecked = false
    ballsFolderRef = nil
end

local function isBallPart(obj): boolean
    if not (obj and obj:IsA("BasePart")) then return false end

    if obj.Name == "VRF_ReachAnchor"
       or obj.Name == "VRF_GKReachAnchor"
       or obj.Name:find("VEF_") == 1
       or obj.Name:find("VRF_") == 1 then
        return false
    end

    local folder = getBallsFolder()
    if folder then
        return obj:IsDescendantOf(folder)
    end

    if BALL_IDENTIFIERS[obj.Name] then return true end
    return CollectionService:HasTag(obj, "TPS")
        or CollectionService:HasTag(obj, "TCS")
        or CollectionService:HasTag(obj, "Ball")
        or CollectionService:HasTag(obj, "BallNetworking")
end

local function getActiveBalls(): {BasePart}
    local targets = {}
    local seen = {}

    for _, ball in ipairs(CollectionService:GetTagged("BallNetworking")) do
        if ball:IsA("BasePart") and not seen[ball] then
            seen[ball] = true
            table.insert(targets, ball)
        end
    end

    local folder = getBallsFolder()
    if folder then
        for _, part in ipairs(folder:GetDescendants()) do
            if part:IsA("BasePart") and not seen[part] then
                seen[part] = true
                table.insert(targets, part)
            end
        end
    else
        for _, part in ipairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") and not seen[part] then
                if isBallPart(part) then
                    seen[part] = true
                    table.insert(targets, part)
                end
            end
        end
    end

    return targets
end

