local function setupCharacterPhysics(char: Model)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    local head = char:WaitForChild("Head", 5)
    local torso = char:WaitForChild("Torso", 5)

    if hrp then hrp.CollisionGroup = 2 end
    if head then
        head.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0, 1, 1, 1)
        head.CollisionGroup = "Default"
    end
    if torso then
        torso.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0, 0, 1, 100)
        torso.CollisionGroup = "Default"
    end

    local partDefs = {
        { name = "H", size = Vector3.new(2, 1, 1) },
        { name = "T", size = Vector3.new(2, 2, 1) },
        { name = "RA", size = Vector3.new(1, 2, 1) },
        { name = "LA", size = Vector3.new(1, 2, 1) },
        { name = "RL", size = Vector3.new(1, 2, 1) },
        { name = "LL", size = Vector3.new(1, 2, 1) }
    }

    for _, def in ipairs(partDefs) do
        if not char:FindFirstChild(def.name) then
            local part = Instance.new("Part")
            part.Size = def.size
            part.Name = def.name
            part.CanCollide = false
            part.Anchored = true
            part.Transparency = 1
            part.Parent = char
        end
    end
end

local function applyBallFriction(ball: BasePart)
    if ballConnections[ball] or not Config.FrictionPatch then return end

    local drag = ball:WaitForChild("Drag", 5)
    local fric = Config.DefaultFriction
    local activeState = false
    local accum = 0

    ballConnections[ball] = RunService.Heartbeat:Connect(function(dt)
        accum = accum + dt
        if accum < 0.05 then return end
        accum = 0

        if ball and ball.Parent then
            local vel = ball.AssemblyLinearVelocity
            if (vel * Vector3.new(1, 0, 1)).Magnitude > 0.01 then
                ball.AssemblyLinearVelocity = vel * Vector3.new(1 - fric, 1, 1 - fric)
            elseif drag then
                drag.Force = Vector3.new(0, 0, 0)
            end
        else
            if ballConnections[ball] then
                ballConnections[ball]:Disconnect()
                ballConnections[ball] = nil
            end
        end
    end)

    ball.ChildAdded:Connect(function(child)
        if child:IsA("BodyVelocity") then
            task.wait()
            local vel = child.Velocity
            if Vector3.new(vel.X, 0, vel.Z).Magnitude > 32.5 and vel.Y > 0.1 then
                activeState = true
                fric = Config.ReducedFriction
            end
        end
    end)

    ball.Touched:Connect(function(other)
        if other.Name == "Grass" and activeState then
            activeState = false
            fric = Config.DefaultFriction
        end
    end)
end

local function initializeBallMonitoring()
    local ballsFolder = Workspace:FindFirstChild("Balls")
    if not ballsFolder then return end

    for _, child in ipairs(ballsFolder:GetChildren()) do
        if child:IsA("BasePart") then
            task.spawn(applyBallFriction, child)
        end
    end

    ballsFolder.ChildAdded:Connect(function(child)
        if child:IsA("BasePart") then
            task.spawn(applyBallFriction, child)
        end
    end)

    ballsFolder.ChildRemoved:Connect(function(child)
        if ballConnections[child] then
            ballConnections[child]:Disconnect()
            ballConnections[child] = nil
        end
    end)
end

