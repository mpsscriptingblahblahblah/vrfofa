end

local function SweepCharacterConnections(char: Model)
    if not (char and getConns) then return end

    local humanoid = char:FindFirstChildWhichIsA("Humanoid")
    if humanoid then
        local props = {"JumpHeight", "WalkSpeed", "WalkToPoint", "HipHeight"}
        for i = 1, #props do
            local signal = humanoid:GetPropertyChangedSignal(props[i])
            for _, conn in ipairs(getConns(signal)) do conn:Disconnect() end
        end
    end

    local LIMB_NAMES = {"H", "T", "RA", "LA", "RL", "LL", "Head", "Torso", "Right Arm", "Left Arm", "Right Leg", "Left Leg"}
    for i = 1, #LIMB_NAMES do
        local part = char:FindFirstChild(LIMB_NAMES[i])
        if part then
            for _, conn in ipairs(getConns(part:GetPropertyChangedSignal("Size"))) do conn:Disconnect() end
        end
    end

    local TARGET_SCRIPTS = {"Mainframe", "AC_Client", "Handler"}
    for i = 1, #TARGET_SCRIPTS do
        local targetScript = char:FindFirstChild(TARGET_SCRIPTS[i])
        if targetScript then
            for _, conn in ipairs(getConns(targetScript:GetPropertyChangedSignal("Enabled"))) do conn:Disconnect() end
            for _, conn in ipairs(getConns(targetScript.AncestryChanged)) do conn:Disconnect() end
            for _, conn in ipairs(getConns(targetScript.Destroying)) do conn:Disconnect() end
            if targetScript:IsA("Script") or targetScript:IsA("LocalScript") then
                targetScript.Disabled = true
            end
        end
    end

    if typeof(getInfo) == "function" then
        for _, conn in ipairs(getConns(RunService.Heartbeat)) do
            local fn = conn.Function or conn.Func or conn.F
            if type(fn) == "function" then
                local info = getInfo(fn)
                if info and info.source and (info.source:find("Mainframe") or info.source:find("AC")) then
                    conn:Disconnect()
                end
            end
        end

        for _, conn in ipairs(getConns(RunService.RenderStepped)) do
            local fn = conn.Function or conn.Func or conn.F
            if type(fn) == "function" then
                local info = getInfo(fn)
                if info and info.source and (info.source:find("VelocityCap") or info.source:find("SpeedCheck")) then
                    conn:Disconnect()
                end
            end
        end
    end
end

