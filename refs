    if not getgenv().guarding then return end

    local myRoot = getRoot(LocalPlayer)
    local myHum = getHumanoid(LocalPlayer)

    if not (myRoot and myHum and targetBall and targetBall.Parent) then return end
    if myHum.Health <= 0 or isPlayerMoving() then return end

    local bp = targetBall.Position
    local mp = myRoot.Position
    local bv = targetBall.AssemblyLinearVelocity

    updateAcceleration(bv)

    local dx = mp.X - bp.X
    local dz = mp.Z - bp.Z
    local dist = math.sqrt(dx * dx + dz * dz)

    if dist > getgenv().settings.maxDist then
        if not windowFocused then issueMove(myHum, mp) end
        return
    end

    local inAir = bp.Y > (mp.Y + 2)
    local targetPos: Vector3

    if inAir then
        local land, t = calculateLandingSpot(bp, bv, mp.Y)
        targetPos = (t > 0.05 and t < getgenv().settings.maxPredTime) and land or Vector3.new(bp.X, mp.Y, bp.Z)
    else
        targetPos = calculateGroundPrediction(bp, bv, mp)
    end

    local tdx = targetPos.X - mp.X
    local tdz = targetPos.Z - mp.Z
    local gap = math.sqrt(tdx * tdx + tdz * tdz)

    if gap > getgenv().settings.stopDist then
        if gap < getgenv().settings.slowdownRange then
            local r = gap / getgenv().settings.slowdownRange
            issueMove(myHum, mp + (targetPos - mp) * r)
        else
            issueMove(myHum, targetPos)
        end
    end

    if getgenv().settings.lookAtBall and dist < 10 then
        local lookPos = inAir and bp or targetPos
        local targetCF = CFrame.lookAt(mp, Vector3.new(lookPos.X, mp.Y, lookPos.Z))
        local speed = math.clamp(getgenv().settings.turnSmooth * (1 + (10 - dist) / 10), 0.05, 0.25)
        myRoot.CFrame = myRoot.CFrame:Lerp(targetCF, speed)
    end
end))

